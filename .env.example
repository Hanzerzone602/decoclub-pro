# DecoClub Pro — copy to .env and fill in. Never commit secrets.
# Set these in Railway Variables instead of committing .env.

PORT=3847
HOST=0.0.0.0

# Public origin used for Stripe return URLs (no trailing slash)
PUBLIC_URL=http://localhost:3847

# Optional. When unset, plan buttons still record membership and show:
# "Billing connects when keys are set"
STRIPE_SECRET_KEY=
STRIPE_PRICE_TRIAL=
STRIPE_PRICE_SHOP=
STRIPE_PRICE_STUDIO=
STRIPE_WEBHOOK_SECRET=

# Persist this directory across deploys (jobs, uploads, sessions)
# DATA_DIR=/data
