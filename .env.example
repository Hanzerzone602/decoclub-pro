PORT=3847
HOST=0.0.0.0
DATA_DIR=./data
PUBLIC_URL=http://localhost:3847
NODE_ENV=development
ALLOW_DEMO=1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Image-credit checkout (Vectorize + Halftones) uses inline Stripe price_data.
# No STRIPE_PRICE_* is required for image credits — only STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET.
# STRIPE_PRICE_TRIAL / SHOP / STUDIO are used only when FEATURE_MEMBERSHIP=1.
STRIPE_PRICE_TRIAL=
STRIPE_PRICE_SHOP=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_HALFTONE_SINGLE=
STRIPE_PRICE_HALFTONE_PACK10=

# Pay-per-image is the default. Set to 1 to bring membership plans or Digitize back.
# FEATURE_MEMBERSHIP=0
# FEATURE_DIGITIZE=0
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional Corel structural prior for PNG Vectorize hallucinate
# RASTER_COREL_PRIOR_SVG=/path/to/artbox.svg
# RASTER_COREL_PRIOR_PNG=/path/to/artbox.png

# Paid Grok Imagine (SpaceXAI API). Leave unset/off unless David enables.
# DECOCLUB_IMAGINE=1
# XAI_API_KEY=
